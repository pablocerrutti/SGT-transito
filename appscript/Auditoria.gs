/********************************************************
 * SGT - AUDITORÍA Y REGISTRO DE ACTIVIDAD
 ********************************************************/
function hojaAuditoria_(){const ss=bd();let sh=ss.getSheetByName('Auditoria');if(!sh){sh=ss.insertSheet('Auditoria');sh.appendRow(['ID','Fecha','Usuario','Nombre','Rol','Acción','Módulo','Detalle','Referencia']);sh.setFrozenRows(1);}return sh;}
function registrarAuditoria(e){const p=(e&&e.parameter)||{};if(String(p.generarPdfAuditoria||'')==='1')return generarPdfAuditoria_(p);const usuario=String(p.usuario||'').trim(),nombre=String(p.nombre||'').trim(),rol=String(p.rol||'').trim(),accion=String(p.accionRealizada||p.accion||'').trim(),modulo=String(p.modulo||'').trim(),detalle=String(p.detalle||'').trim(),referencia=String(p.referencia||'').trim();if(!accion)return{ok:false,mensaje:'Falta indicar la acción realizada.'};try{hojaAuditoria_().appendRow([generarID('AUD'),ahora(),usuario,nombre,rol,accion,modulo,detalle,referencia]);return{ok:true,mensaje:'Acción registrada en auditoría.'};}catch(error){return{ok:false,mensaje:'No fue posible registrar la auditoría: '+(error.message||error)};}}
function obtenerAuditoria(e){try{const sh=hojaAuditoria_();if(sh.getLastRow()<2)return{ok:true,datos:[]};const v=sh.getDataRange().getDisplayValues();const datos=v.slice(1).filter(f=>String(f[0]||'').trim()).map(f=>({id:f[0],fecha:f[1],usuario:f[2],nombre:f[3],rol:f[4],accion:f[5],modulo:f[6],detalle:f[7],referencia:f[8]})).reverse();return{ok:true,datos:datos};}catch(error){return{ok:false,datos:[],mensaje:'No fue posible obtener la auditoría: '+(error.message||error)};}}
function obtenerInformesAuditoria(e){try{const r=obtenerInspecciones(e);if(!r||!r.ok)return r;const datos=(r.datos||[]).map(x=>{const rol=String(x.rol||'').toLowerCase(),esMovilidad=rol==='movilidad';const tipo=esMovilidad?(String(x.elementoId||'').trim()?'Inspección de elemento':'Informe de Movilidad'):'Reporte de Fiscalización';return Object.assign({},x,{categoriaInforme:tipo});});return{ok:true,datos:datos};}catch(error){return{ok:false,datos:[],mensaje:'No fue posible obtener los informes: '+(error.message||error)};}}
function generarPdfAuditoria_(p){try{const sh=hojaAuditoria_();const v=sh.getDataRange().getDisplayValues();const filas=v.length>1?v.slice(1).filter(f=>String(f[0]||'').trim()):[];const usuario=String(p.usuarioFiltro||'').trim().toLowerCase(),rol=String(p.rolFiltro||'').trim().toLowerCase();const filtradas=filas.filter(f=>{const u=String(f[2]||'').trim().toLowerCase(),r=String(f[4]||'').trim().toLowerCase();return(!usuario||u===usuario)&&(!rol||r===rol);});if(!filtradas.length)return{ok:false,mensaje:'No existen acciones para el filtro seleccionado.'};const titulo=usuario?'Auditoría - '+String(p.nombreFiltro||p.usuarioFiltro).trim():'Auditoría general del sistema';const esc=function(x){return String(x==null?'':x).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;');};const filasHtml=filtradas.map(f=>'<tr><td>'+esc(f[1])+'</td><td>'+esc(f[2])+'</td><td>'+esc(f[3])+'</td><td>'+esc(f[4])+'</td><td>'+esc(f[5])+'</td><td>'+esc(f[6])+'</td><td>'+esc(f[7])+'</td><td>'+esc(f[8])+'</td></tr>').join('');const html='<!DOCTYPE html><html><head><meta charset="UTF-8"><style>@page{size:A4 landscape;margin:12mm;}body{font-family:Arial,sans-serif;color:#202124;font-size:8px;}h1{color:#b40000;font-size:18px;margin:0 0 4px;}p{margin:2px 0 10px;color:#555;}table{width:100%;border-collapse:collapse;}th{background:#b40000;color:#fff;padding:5px;text-align:left;}td{border:1px solid #ccc;padding:4px;vertical-align:top;}tr:nth-child(even) td{background:#f7f7f7;}.footer{margin-top:10px;font-size:8px;color:#666;border-top:1px solid #b40000;padding-top:4px;}</style></head><body><h1>'+esc(titulo)+'</h1><p>SGT - Sistema de Gestión de Tránsito | Generado: '+esc(ahora())+' | Registros: '+filtradas.length+'</p><table><thead><tr><th>Fecha y hora</th><th>Usuario</th><th>Nombre</th><th>Rol</th><th>Acción</th><th>Módulo</th><th>Detalle</th><th>Referencia</th></tr></thead><tbody>'+filasHtml+'</tbody></table><div class="footer">Documento generado automáticamente desde el módulo de Auditoría.</div></body></html>';const blob=Utilities.newBlob(html,'text/html',titulo+'.html').getAs(MimeType.PDF).setName(titulo+'.pdf');const folder=DriveApp.getFolderById(CARPETA_ACTUACIONES_ID_);const file=folder.createFile(blob);return{ok:true,mensaje:'PDF de auditoría generado correctamente.',pdfUrl:file.getUrl(),pdfDownloadUrl:'https://drive.google.com/uc?export=download&id='+encodeURIComponent(file.getId()),pdfNombre:file.getName(),cantidad:filtradas.length};}catch(error){return{ok:false,mensaje:'No fue posible generar el PDF de auditoría: '+(error.message||error)};}}
