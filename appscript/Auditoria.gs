/********************************************************
 * SGT - AUDITORÍA Y REGISTRO DE ACTIVIDAD
 ********************************************************/
function hojaAuditoria_(){const ss=bd();let sh=ss.getSheetByName('Auditoria');if(!sh){sh=ss.insertSheet('Auditoria');sh.appendRow(['ID','Fecha','Usuario','Nombre','Rol','Acción','Módulo','Detalle','Referencia']);sh.setFrozenRows(1);}return sh;}
function registrarAuditoria(e){const p=(e&&e.parameter)||{},usuario=String(p.usuario||'').trim(),nombre=String(p.nombre||'').trim(),rol=String(p.rol||'').trim(),accion=String(p.accionRealizada||p.accion||'').trim(),modulo=String(p.modulo||'').trim(),detalle=String(p.detalle||'').trim(),referencia=String(p.referencia||'').trim();if(!accion)return{ok:false,mensaje:'Falta indicar la acción realizada.'};try{hojaAuditoria_().appendRow([generarID('AUD'),ahora(),usuario,nombre,rol,accion,modulo,detalle,referencia]);return{ok:true,mensaje:'Acción registrada en auditoría.'};}catch(error){return{ok:false,mensaje:'No fue posible registrar la auditoría: '+(error.message||error)};}}
function obtenerAuditoria(e){try{const sh=hojaAuditoria_();if(sh.getLastRow()<2)return{ok:true,datos:[]};const v=sh.getDataRange().getDisplayValues();const datos=v.slice(1).filter(f=>String(f[0]||'').trim()).map(f=>({id:f[0],fecha:f[1],usuario:f[2],nombre:f[3],rol:f[4],accion:f[5],modulo:f[6],detalle:f[7],referencia:f[8]})).reverse();return{ok:true,datos:datos};}catch(error){return{ok:false,datos:[],mensaje:'No fue posible obtener la auditoría: '+(error.message||error)};}}
function obtenerInformesAuditoria(e){try{const r=obtenerInspecciones(e);if(!r||!r.ok)return r;const datos=(r.datos||[]).map(x=>{const rol=String(x.rol||'').toLowerCase(),esMovilidad=rol==='movilidad';const tipo=esMovilidad?(String(x.elementoId||'').trim()?'Inspección de elemento':'Informe de Movilidad'):'Reporte de Fiscalización';return Object.assign({},x,{categoriaInforme:tipo});});return{ok:true,datos:datos};}catch(error){return{ok:false,datos:[],mensaje:'No fue posible obtener los informes: '+(error.message||error)};}}
