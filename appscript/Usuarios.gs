const USR_COL={ID:1,USUARIO:2,NOMBRE:3,PASSWORD:4,BETA:5,ROL:6,ACTIVO:7,FECHA_ALTA:8,PASSWORD_TEMPORAL:9,FECHA_CAMBIO:10,PERMISOS:11};
function normalizarUsuario_(v){return String(v||'').trim().toLowerCase();} function normalizarRolUsuario_(v){return String(v||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim();} function esRolSuperAdmin_(rol){return ['super admin','super administrador','superadministrador'].includes(normalizarRolUsuario_(rol));}
function permisosPorRol_(rol){const r=normalizarRolUsuario_(rol);if(esRolSuperAdmin_(r)||r==='administrador'||r==='admin')return{usuarios:true,movilidad:true,inspector:true,auditoria:true};if(r==='supervisor')return{usuarios:false,movilidad:true,inspector:true,auditoria:true};if(r==='supervisor movilidad')return{usuarios:false,movilidad:true,inspector:false,auditoria:false};if(r==='movilidad'||r==='consulta movilidad')return{usuarios:false,movilidad:true,inspector:false,auditoria:false};if(r==='fiscalizacion'||r==='inspector')return{usuarios:false,movilidad:false,inspector:true,auditoria:false};return{usuarios:false,movilidad:false,inspector:false,auditoria:false};}
function hojaUsuarios_(){return hoja('Usuarios');} function buscarUsuarioPorNombre_(usuario){const n=normalizarUsuario_(usuario),sh=hojaUsuarios_();if(!n||!sh)return null;const datos=sh.getDataRange().getValues();for(let i=1;i<datos.length;i++)if(normalizarUsuario_(datos[i][USR_COL.USUARIO-1])===n)return{fila:datos[i],numeroFila:i+1};return null;} function usuarioEsSuperAdminPorNombre_(usuario){const x=buscarUsuarioPorNombre_(usuario);return !!x&&esRolSuperAdmin_(x.fila[USR_COL.ROL-1]);} function esSuperAdminActor_(e){return usuarioEsSuperAdminPorNombre_(((e&&e.parameter)||{}).actorUsuario||'');}
function usuarioEstaActivo_(fila){return ['si','sí','true','1','activo'].includes(String(fila[USR_COL.ACTIVO-1]||'').trim().toLowerCase());} function permisosDeFila_(fila){const base=permisosPorRol_(fila[USR_COL.ROL-1]);if(esRolSuperAdmin_(fila[USR_COL.ROL-1]))return base;const raw=fila[USR_COL.PERMISOS-1];if(raw)try{const p=typeof raw==='object'?raw:JSON.parse(String(raw));Object.keys(base).forEach(k=>{if(typeof p[k]==='boolean')base[k]=p[k];});}catch(_){}return base;}
function usuarioTienePermisoModulo_(usuario,modulo){const x=buscarUsuarioPorNombre_(usuario);if(!x||!usuarioEstaActivo_(x.fila))return false;const p=permisosDeFila_(x.fila),m=String(modulo||'').trim();if(m==='fiscalizacion')return p.fiscalizacion===true||p.inspector===true;return p[m]===true;} function permisoModuloApi_(e,modulo){const actor=typeof e==='string'?e:String(((e&&e.parameter)||{}).actorUsuario||'').trim();return usuarioTienePermisoModulo_(actor,modulo)?null:{ok:false,codigo:'PERMISO_MODULO_DENEGADO',mensaje:'El usuario no tiene habilitado el acceso al módulo '+modulo+'.'};}
function validarBeta_(beta){return beta===''||/^\d+$/.test(beta);} function login(e){const d=(e&&e.parameter)||{},usuario=String(d.usuario||'').trim(),password=String(d.password||'').trim(),x=buscarUsuarioPorNombre_(usuario);if(!x||String(x.fila[USR_COL.PASSWORD-1]||'').trim()!==password||!usuarioEstaActivo_(x.fila))return{ok:false,mensaje:'Usuario o contraseña incorrectos.'};const f=x.fila,pt=normalizarUsuario_(f[USR_COL.PASSWORD_TEMPORAL-1]);return{ok:true,usuario:{id:f[USR_COL.ID-1],usuario:f[USR_COL.USUARIO-1],nombre:f[USR_COL.NOMBRE-1],beta:String(f[USR_COL.BETA-1]||'').trim(),rol:f[USR_COL.ROL-1],activo:f[USR_COL.ACTIVO-1],permisos:permisosDeFila_(f),requiereCambioPassword:['si','sí','true','1'].includes(pt)}};}
function obtenerUsuarios(e){if(!esSuperAdminActor_(e))return{ok:false,mensaje:'Permiso denegado. Solo Super Admin puede administrar usuarios.'};const sh=hojaUsuarios_(),datos=sh.getDataRange().getValues(),lista=[];for(let i=1;i<datos.length;i++){const f=datos[i];if(!String(f[USR_COL.ID-1]||'').trim())continue;lista.push({id:f[USR_COL.ID-1],usuario:f[USR_COL.USUARIO-1],nombre:f[USR_COL.NOMBRE-1],beta:String(f[USR_COL.BETA-1]||'').trim(),rol:f[USR_COL.ROL-1],activo:f[USR_COL.ACTIVO-1],fechaAlta:f[USR_COL.FECHA_ALTA-1],passwordTemporal:f[USR_COL.PASSWORD_TEMPORAL-1],fechaCambioPassword:f[USR_COL.FECHA_CAMBIO-1],permisos:permisosDeFila_(f)});}return{ok:true,datos:lista,usuarios:lista};}
function guardarUsuario(e){const d=(e&&e.parameter)||{};if(!esSuperAdminActor_(e))return{ok:false,mensaje:'Permiso denegado. Solo Super Admin puede crear usuarios.'};const usuario=String(d.usuario||'').trim(),nombre=String(d.nombre||'').trim(),password=String(d.password||''),rol=String(d.rol||'').trim(),beta=String(d.beta||'').trim(),activo=String(d.activo||'SI').trim();if(!usuario||!nombre||!password||!rol)return{ok:false,mensaje:'Complete todos los datos obligatorios del usuario.'};if(!validarBeta_(beta))return{ok:false,mensaje:'El Número Beta es opcional, pero si se ingresa debe contener solamente números.'};if(buscarUsuarioPorNombre_(usuario))return{ok:false,mensaje:'El nombre de usuario ya existe.'};let p=permisosPorRol_(rol);if(d.permisos)try{const x=JSON.parse(d.permisos);Object.keys(p).forEach(k=>{if(typeof x[k]==='boolean')p[k]=x[k];});}catch(_){}if(esRolSuperAdmin_(rol))p.usuarios=true;const sh=hojaUsuarios_();sh.appendRow([generarID('USR'),usuario,nombre,password,beta,rol,activo,ahora(),'SI','',JSON.stringify(p)]);return{ok:true,mensaje:'Usuario creado correctamente.'};}
function actualizarUsuario(e){const d=(e&&e.parameter)||{};if(!esSuperAdminActor_(e))return{ok:false,mensaje:'Permiso denegado. Solo Super Admin puede modificar usuarios.'};const id=String(d.id||'').trim(),sh=hojaUsuarios_(),datos=sh.getDataRange().getValues();let idx=-1;for(let i=1;i<datos.length;i++)if(String(datos[i][USR_COL.ID-1])===id){idx=i;break;}if(idx<0)return{ok:false,mensaje:'Usuario no encontrado.'};const f=datos[idx],nuevoUsuario=String(d.usuario||f[USR_COL.USUARIO-1]||'').trim(),nombre=String(d.nombre||f[USR_COL.NOMBRE-1]||'').trim(),rol=String(d.rol||f[USR_COL.ROL-1]||'').trim(),beta=String(d.beta||'').trim(),activo=String(d.activo||f[USR_COL.ACTIVO-1]||'').trim(),password=String(d.password||'');if(!validarBeta_(beta))return{ok:false,mensaje:'El Número Beta es opcional, pero si se ingresa debe contener solamente números.'};for(let j=1;j<datos.length;j++)if(j!==idx&&normalizarUsuario_(datos[j][USR_COL.USUARIO-1])===normalizarUsuario_(nuevoUsuario))return{ok:false,mensaje:'El nombre de usuario ya existe.'};sh.getRange(idx+1,USR_COL.USUARIO).setValue(nuevoUsuario);sh.getRange(idx+1,USR_COL.NOMBRE).setValue(nombre);sh.getRange(idx+1,USR_COL.BETA).setValue(beta);sh.getRange(idx+1,USR_COL.ROL).setValue(rol);sh.getRange(idx+1,USR_COL.ACTIVO).setValue(activo);if(password.trim()){sh.getRange(idx+1,USR_COL.PASSWORD).setValue(password.trim());sh.getRange(idx+1,USR_COL.PASSWORD_TEMPORAL).setValue('SI');sh.getRange(idx+1,USR_COL.FECHA_CAMBIO).setValue('');}let p=permisosPorRol_(rol);if(d.permisos)try{const x=JSON.parse(d.permisos);Object.keys(p).forEach(k=>{if(typeof x[k]==='boolean')p[k]=x[k];});}catch(_){}if(esRolSuperAdmin_(rol))p.usuarios=true;sh.getRange(idx+1,USR_COL.PERMISOS).setValue(JSON.stringify(p));return{ok:true,mensaje:'Usuario actualizado correctamente.',usuario:{id:f[USR_COL.ID-1],usuario:nuevoUsuario,nombre:nombre,beta:beta,rol:rol,activo:activo,permisos:p}};}
function eliminarUsuario(e){const d=(e&&e.parameter)||{};if(!esSuperAdminActor_(e))return{ok:false,mensaje:'Permiso denegado. Solo Super Admin puede eliminar usuarios.'};const id=String(d.id||'').trim(),actor=normalizarUsuario_(d.actorUsuario||''),sh=hojaUsuarios_(),datos=sh.getDataRange().getValues();for(let i=1;i<datos.length;i++)if(String(datos[i][USR_COL.ID-1])===id){const f=datos[i],objetivo=normalizarUsuario_(f[USR_COL.USUARIO-1]);if(objetivo===actor)return{ok:false,mensaje:'No puede eliminar su propio usuario.'};if(esRolSuperAdmin_(f[USR_COL.ROL-1])){const pc=String(d.passwordConfirmacion||'');if(!pc)return{ok:false,codigo:'REQUIERE_PASSWORD_OBJETIVO',mensaje:'Para eliminar a otro Super Admin debe verificar la contraseña de ese usuario.'};if(pc!==String(f[USR_COL.PASSWORD-1]||''))return{ok:false,codigo:'PASSWORD_OBJETIVO_INVALIDA',mensaje:'La contraseña del Super Admin a eliminar no coincide.'};}sh.deleteRow(i+1);return{ok:true,mensaje:'Usuario eliminado correctamente.'};}return{ok:false,mensaje:'Usuario no encontrado.'};}
function diagnosticoActor(e){const actor=String(((e&&e.parameter)||{}).actorUsuario||'').trim(),x=buscarUsuarioPorNombre_(actor);return{ok:true,diagnostico:true,actorUsuarioRecibido:actor,usuarioEncontrado:!!x,rolReal:x?x.fila[USR_COL.ROL-1]:'',esSuperAdmin:!!x&&esRolSuperAdmin_(x.fila[USR_COL.ROL-1]),hoja:'Usuarios',columnas:{usuario:'B',nombre:'C',password:'D',beta:'E',rol:'F',activo:'G',fechaAlta:'H',passwordTemporal:'I',fechaCambioPassword:'J',permisos:'K'}};}
